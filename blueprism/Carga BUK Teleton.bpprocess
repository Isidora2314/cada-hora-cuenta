    </outputs>
    <onsuccess>37203d64-cd78-5287-9cc2-785bc0028178</onsuccess>
    <resource object="MS Excel VBO" action="Create Instance" />
  </stage>
  <stage stageid="37203d64-cd78-5287-9cc2-785bc0028178" name="Abrir BUK" type="Action">
    <loginhibit onsuccess="true" />
    <display x="15" y="-45" />
    <inputs>
      <input type="number" name="handle" expr="[Handle]" />
      <input type="text" name="File name" expr="[Ruta Archivo]" />
    </inputs>
