  <stage stageid="11ecd869-6cdd-5910-9222-a96bfb59044e" name="Carga BUK Teleton" type="ProcessInfo">
    <loginhibit onsuccess="true" />
    <narrative>Lee el reporte BUK, valida cada fila, guarda Errores_BUK.xlsx y envía los datos al backend (que detecta altas, bajas y cambios y recalcula la planificación). Botathon 2026.</narrative>
    <display x="-420" y="-165" w="150" h="90" />
  </stage>
  <stage stageid="4f17d473-3f7b-52fd-b47c-16507f516ea3" name="Start" type="Start">
    <loginhibit onsuccess="true" />
    <display x="15" y="-165" />
