  <stage stageid="66e0dd5c-1584-5a0f-a14a-30934cdaf64b" name="Start" type="Start">
    <subsheetid>afc6ee1f-bac4-5668-9faf-7b3ada88ced6</subsheetid>
    <loginhibit onsuccess="true" />
    <display x="15" y="-105" />
    <inputs>
      <input type="text" name="URL Base" narrative="Dirección del backend, por ejemplo https://xxxx-4000.app.github.dev" stage="URL Base" />
      <input type="text" name="API Key" narrative="Valor de BOT_API_KEY del archivo backend/.env" stage="API Key" />
      <input type="text" name="Tipo" narrative="buk o sic" stage="Tipo" />
      <input type="text" name="Archivo" narrative="Nombre del Excel leído (queda en el historial)" stage="Archivo" />
      <input type="collection" name="Registros" narrative="Colección leída del Excel" stage="Registros" />
    </inputs>
    <onsuccess>24d79455-7b4e-59dc-ae7e-32df29c614a7</onsuccess>
