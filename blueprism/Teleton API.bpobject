  <stage stageid="79dcf8b7-b8b4-5a5a-a849-ea3c9b389bb1" name="Enviar Errores" type="SubSheetInfo">
    <subsheetid>3bd520bc-6329-5c4e-9dfa-58077a99902a</subsheetid>
    <loginhibit onsuccess="true" />
    <narrative>Envía al backend los errores que encontró el bot (colección con PersonaId, Instituto y Motivo).</narrative>
    <display x="-195" y="-105" w="150" h="90" />
  </stage>
  <stage stageid="08c72f9b-5484-5958-a100-e0a6a09e60be" name="Start" type="Start">
    <subsheetid>3bd520bc-6329-5c4e-9dfa-58077a99902a</subsheetid>
    <loginhibit onsuccess="true" />
    <display x="15" y="-105" />
    <inputs>
      <input type="text" name="URL Base" narrative="Dirección del backend, por ejemplo https://xxxx-4000.app.github.dev" stage="URL Base" />
      <input type="text" name="API Key" narrative="Valor de BOT_API_KEY del archivo backend/.env" stage="API Key" />
      <input type="text" name="Archivo" narrative="Nombre del Excel leído" stage="Archivo" />
      <input type="collection" name="Errores" narrative="Colección Errores del proceso" stage="Errores" />
    </inputs>
    <onsuccess>ac1d8d12-af65-5541-93fd-8082b1aefbd9</onsuccess>
  </stage>
  <stage stageid="ac1d8d12-af65-5541-93fd-8082b1aefbd9" name="Enviar lista de errores" type="Code">
    <subsheetid>3bd520bc-6329-5c4e-9dfa-58077a99902a</subsheetid>
    <loginhibit onsuccess="true" />
    <display x="15" y="-15" w="90" h="45" />
    <inputs>
      <input type="text" name="URLBase" expr="[URL Base]" />
      <input type="text" name="APIKey" expr="[API Key]" />
      <input type="text" name="Archivo" expr="[Archivo]" />
      <input type="collection" name="Errores" expr="[Errores]" />
    </inputs>
    <outputs>
      <output type="flag" name="Exito" stage="Exito" />
      <output type="number" name="CodigoHTTP" stage="Codigo HTTP" />
      <output type="text" name="Respuesta" stage="Respuesta" />
      <output type="number" name="ErroresEnviados" stage="Errores Enviados" />
    </outputs>
    <onsuccess>4a182cd7-626e-599f-9276-810d2be57ab4</onsuccess>
    <code><![CDATA[
' Envía los errores que encontró el bot (colección con columnas PersonaId, Instituto y Motivo)
Dim sb As New StringBuilder()
sb.Append("{""archivo"":""").Append(JsonEscape(Archivo)).Append(""",""errores"":[")
Dim n As Integer = 0
For Each fila As DataRow In Errores.Rows
    Dim motivo As String = Columna(fila, "Motivo")
    If motivo = "" OrElse motivo.StartsWith("Sin errores") Then Continue For
    If n > 0 Then sb.Append(",")
    n += 1
    Dim inst As String = Columna(fila, "Instituto")
    If inst <> "" Then motivo = motivo & " (" & inst & ")"
    sb.Append("{""fila"":").Append(n)
    sb.Append(",""columna"":"""",""tipo"":""VALIDACION_BOT""")
    sb.Append(",""valor"":""").Append(JsonEscape(Columna(fila, "PersonaId"))).Append("""")
    sb.Append(",""mensaje"":""").Append(JsonEscape(motivo)).Append("""}")
Next
sb.Append("]}")
ErroresEnviados = n
If n = 0 Then
    Respuesta = "No hay errores que informar"
    CodigoHTTP = 0
    Exito = True
Else
    Dim codigo As Integer = 0
    Respuesta = Enviar("POST", UnirUrl(URLBase, "/api/bot/errores"), APIKey, sb.ToString(), codigo)
    CodigoHTTP = codigo
    Exito = (codigo = 200)
End If
]]></code>
  </stage>
  <stage stageid="4a182cd7-626e-599f-9276-810d2be57ab4" name="End" type="End">
    <subsheetid>3bd520bc-6329-5c4e-9dfa-58077a99902a</subsheetid>
    <loginhibit onsuccess="true" />
    <display x="15" y="90" />
    <outputs>
      <output type="flag" name="Exito" narrative="True si el backend respondió 200" stage="Exito" />
      <output type="number" name="Codigo HTTP" narrative="Código HTTP (0 = sin conexión)" stage="Codigo HTTP" />
      <output type="text" name="Respuesta" narrative="Texto que respondió el backend" stage="Respuesta" />
      <output type="number" name="Errores Enviados" narrative="Cantidad de errores informados" stage="Errores Enviados" />
    </outputs>
  </stage>
