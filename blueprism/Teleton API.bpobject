  <stage stageid="24d79455-7b4e-59dc-ae7e-32df29c614a7" name="Convertir y enviar" type="Code">
    <subsheetid>afc6ee1f-bac4-5668-9faf-7b3ada88ced6</subsheetid>
    <loginhibit onsuccess="true" />
    <display x="15" y="-15" w="90" h="45" />
    <inputs>
      <input type="text" name="URLBase" expr="[URL Base]" />
      <input type="text" name="APIKey" expr="[API Key]" />
      <input type="text" name="Tipo" expr="[Tipo]" />
      <input type="text" name="Archivo" expr="[Archivo]" />
      <input type="collection" name="Registros" expr="[Registros]" />
    </inputs>
    <outputs>
      <output type="flag" name="Exito" stage="Exito" />
      <output type="number" name="CodigoHTTP" stage="Codigo HTTP" />
      <output type="text" name="Respuesta" stage="Respuesta" />
      <output type="number" name="CambiosDetectados" stage="Cambios Detectados" />
      <output type="number" name="TotalErrores" stage="Total Errores" />
      <output type="number" name="RegistrosEnviados" stage="Registros Enviados" />
    </outputs>
    <onsuccess>2e864753-713c-5674-b661-b77715d2040b</onsuccess>
    <code><![CDATA[
' Tipo = "buk" o "sic"
Dim ruta As String = "/api/bot/" & Tipo.Trim().ToLower()
Dim cuerpo As String = "{""archivo"":""" & JsonEscape(Archivo) & """,""registros"":" & TablaAJson(Registros) & "}"
Dim codigo As Integer = 0
Respuesta = Enviar("POST", UnirUrl(URLBase, ruta), APIKey, cuerpo, codigo)
CodigoHTTP = codigo
Exito = (codigo = 200)
CambiosDetectados = NumeroJson(Respuesta, "cambiosDetectados")
TotalErrores = NumeroJson(Respuesta, "totalErrores")
RegistrosEnviados = Registros.Rows.Count
]]></code>
  </stage>
