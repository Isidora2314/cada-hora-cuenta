# Copia este archivo como ".env" y cambia los valores

# Puerto del backend
PORT=4000

# Clave para firmar los tokens JWT (cámbiala por un texto largo y secreto)
JWT_SECRET=cambia-esta-clave-secreta

# API key que usará Blue Prism para llamar a /api/bot/*
BOT_API_KEY=cambia-esta-api-key-del-bot

# (Opcional) Base de datos Supabase. Si está vacía, se usan los JSON de backend/data.
# En Supabase: Project Settings → Database → Connection string → "Session pooler" (URI).
# Ejemplo: postgresql://postgres.abcdefgh:TU-CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
